{
  "name": "text-display",
  "productName": "Text Display",
  "version": "0.2.1",
  "description": "Messages are pasted in on a submission page, reviewed in an admin panel, and displayed on a full-bleed page (NDI/alpha friendly).",
  "author": "Connection Pointe Christian Church",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node src/serve.js",
    "version:patch": "npm version patch -m \"Release v%s\"",
    "version:minor": "npm version minor -m \"Release v%s\"",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "koffi": "^3.3.4"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.connectionpointe.textdisplay",
    "productName": "Text Display",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-admin.js",
      "src/**/*",
      "public/**/*",
      "package.json",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "darkModeSupport": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
